rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isOrganizer() {
      return userRole() == 'organizador';
    }

    function teamMembershipId(teamId, userId) {
      return teamId + '_' + userId;
    }

    function isOrganizerAllowlisted(userId) {
      return exists(/databases/$(database)/documents/organizer_allowlist/$(userId)) &&
        get(/databases/$(database)/documents/organizer_allowlist/$(userId)).data.enabled == true &&
        get(/databases/$(database)/documents/organizer_allowlist/$(userId)).data.uid == userId;
    }

    function isActiveMembershipStatus(status) {
      return !(status in ['sem_time', 'removido']);
    }

    function isActiveTeamMember(teamId, userId) {
      let membership = get(
        /databases/$(database)/documents/team_memberships/$(teamMembershipId(teamId, userId))
      ).data;
      return membership != null &&
        membership.teamId == teamId &&
        membership.userId == userId &&
        isActiveMembershipStatus(membership.status);
    }

    function isChampionshipOrganizer(champId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/championships/$(champId)).data.organizerId == uid();
    }

    function isTeamCaptain(teamId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.captainId == uid();
    }

    // ── /users ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      // BE-01: cada usuário só lê o PRÓPRIO documento. Email e demais dados pessoais
      // deixam de ficar expostos a terceiros. Tokens de push NÃO vivem mais aqui —
      // ficam em /push_tokens (lido pelo dono ou por um organizador para fan-out).
      allow read: if isSignedIn() && uid() == userId;
      function selfUserKeysAreSafe() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'role',
          'teamId',
          'championshipId'
        ]);
      }

      function roleIsAllowedForSelf() {
        return !('role' in request.resource.data) ||
          request.resource.data.role in ['atleta', 'capitao'] ||
          (request.resource.data.role == 'organizador' && isOrganizerAllowlisted(userId));
      }

      allow create: if isSignedIn() &&
        uid() == userId &&
        roleIsAllowedForSelf();
      allow update: if isSignedIn() && (
        (
          uid() == userId &&
          selfUserKeysAreSafe() &&
          roleIsAllowedForSelf()
        ) ||
        isOrganizer()
      );
      allow delete: if isSignedIn() && isOrganizer();
    }

    match /organizer_allowlist/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isOrganizer());
      allow create, update: if isSignedIn() &&
        isOrganizer() &&
        request.resource.data.uid == userId;
      allow delete: if isSignedIn() && isOrganizer();
    }

    // ── /championships ───────────────────────────────────────────────────────

    match /championships/{champId} {
      function captainTeamRegistrationCounterUpdateIsSafe() {
        let teamId = request.resource.data.lastTeamRegistrationId;
        let teamPath = /databases/$(database)/documents/teams/$(teamId);
        let invitePath = /databases/$(database)/documents/team_invites/$(teamId);
        let maxTeams = resource.data.maxTeams == null ? 100000 : resource.data.maxTeams;
        return teamId is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'registeredTeamsCount',
            'lastTeamRegistrationId'
          ]) &&
          request.resource.data.registeredTeamsCount is int &&
          request.resource.data.registeredTeamsCount > 0 &&
          request.resource.data.registeredTeamsCount <= maxTeams &&
          (
            (
              resource.data.registeredTeamsCount is int &&
              request.resource.data.registeredTeamsCount == resource.data.registeredTeamsCount + 1
            ) ||
            !(resource.data.registeredTeamsCount is int)
          ) &&
          existsAfter(teamPath) &&
          getAfter(teamPath).data.championshipId == champId &&
          getAfter(teamPath).data.captainId == uid() &&
          getAfter(teamPath).data.status != 'rejeitado' &&
          existsAfter(invitePath) &&
          getAfter(invitePath).data.teamId == teamId &&
          getAfter(invitePath).data.championshipId == champId &&
          getAfter(invitePath).data.createdBy == uid();
      }

      allow read: if isSignedIn();
      // Only an organizer can create their own championship
      allow create: if isSignedIn() && isOrganizer() &&
        request.resource.data.organizerId == uid();
      // Only the owning organizer can update/delete it
      allow update: if isSignedIn() && (
        resource.data.organizerId == uid() ||
        captainTeamRegistrationCounterUpdateIsSafe()
      );
      allow delete: if isSignedIn() && resource.data.organizerId == uid();
    }

    // ── /teams ───────────────────────────────────────────────────────────────

    match /teams/{teamId} {
      function championshipAcceptsTeamCreate() {
        let champ = get(/databases/$(database)/documents/championships/$(request.resource.data.championshipId)).data;
        return champ != null &&
          champ.status == 'inscricoes_abertas' &&
          (champ.registrationsClosed == null || champ.registrationsClosed == false) &&
          (
            request.resource.data.status == 'pendente' ||
            (champ.rules.manualApproval == false && request.resource.data.status == 'aprovado')
          );
      }

      function captainTeamUpdateIsSafe() {
        return request.resource.data.championshipId == resource.data.championshipId &&
          request.resource.data.captainId == resource.data.captainId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'primaryColor',
            'secondaryColor',
            'logoUrl',
            'logoPreset',
            'inviteCode',
            'inviteLink',
            'registrationOpen',
            'maxPlayers',
            'pendingRequests',
            'approvedPlayersCount'
          ]);
      }

      function ownActiveMembershipCreatedAfter() {
        let membershipPath =
          /databases/$(database)/documents/team_memberships/$(teamMembershipId(teamId, uid()));
        return !exists(membershipPath) &&
          existsAfter(membershipPath) &&
          getAfter(membershipPath).data.teamId == teamId &&
          getAfter(membershipPath).data.userId == uid() &&
          isActiveMembershipStatus(getAfter(membershipPath).data.status);
      }

      function athleteJoinCounterUpdateIsSafe() {
        let maxPlayers = resource.data.maxPlayers == null ? 15 : resource.data.maxPlayers;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approvedPlayersCount'
          ]) &&
          request.resource.data.approvedPlayersCount is int &&
          request.resource.data.approvedPlayersCount > 0 &&
          request.resource.data.approvedPlayersCount <= maxPlayers &&
          (
            (
              resource.data.approvedPlayersCount is int &&
              request.resource.data.approvedPlayersCount == resource.data.approvedPlayersCount + 1
            ) ||
            !(resource.data.approvedPlayersCount is int)
          ) &&
          ownActiveMembershipCreatedAfter();
      }

      function ownActiveMembershipMarkedInactiveAfter() {
        let membershipPath =
          /databases/$(database)/documents/team_memberships/$(teamMembershipId(teamId, uid()));
        return exists(membershipPath) &&
          existsAfter(membershipPath) &&
          getAfter(membershipPath).data.teamId == teamId &&
          getAfter(membershipPath).data.userId == uid() &&
          getAfter(membershipPath).data.status == 'sem_time';
      }

      function athleteLeaveCounterUpdateIsSafe() {
        let maxPlayers = resource.data.maxPlayers == null ? 15 : resource.data.maxPlayers;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'approvedPlayersCount'
          ]) &&
          request.resource.data.approvedPlayersCount is int &&
          request.resource.data.approvedPlayersCount >= 0 &&
          request.resource.data.approvedPlayersCount <= maxPlayers &&
          (
            (
              resource.data.approvedPlayersCount is int &&
              (
                (
                  resource.data.approvedPlayersCount > 0 &&
                  request.resource.data.approvedPlayersCount == resource.data.approvedPlayersCount - 1
                ) ||
                (
                  resource.data.approvedPlayersCount == 0 &&
                  request.resource.data.approvedPlayersCount == 0
                )
              )
            ) ||
            !(resource.data.approvedPlayersCount is int)
          ) &&
          ownActiveMembershipMarkedInactiveAfter();
      }

      allow read: if isSignedIn();
      // Team creation: any signed-in user (becomes captain)
      allow create: if isSignedIn() &&
        request.resource.data.captainId == uid() &&
        championshipAcceptsTeamCreate();
      // Updates/deletes: captain or organizer of the championship
      allow update: if isSignedIn() && (
        (
          resource.data.captainId == uid() &&
          captainTeamUpdateIsSafe()
        ) ||
        athleteJoinCounterUpdateIsSafe() ||
        athleteLeaveCounterUpdateIsSafe() ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
      allow delete: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId);
    }

    // ── /players ─────────────────────────────────────────────────────────────
    // BE-02: Validações fortalecidas para impedir bypass direto via SDK.
    // ⚠️ PARCIAL: Limite de elenco (maxPlayers) e "usuário já em outro time"
    // requerem COUNT/query, impossíveis nas rules. Recomenda-se Cloud Function
    // para garantia total. As validações abaixo cobrem o máximo possível.

    match /players/{playerId} {
      allow read: if isSignedIn();

      // Helper: verifica se o time existe, está aprovado e pertence ao campeonato informado
      function isValidTeamForPlayer() {
        let team = get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data;
        return team != null &&
          team.status == 'aprovado' &&
          team.championshipId == request.resource.data.championshipId;
      }

      // Helper: verifica se o campeonato aceita inscrições
      function isChampionshipOpen() {
        let champ = get(/databases/$(database)/documents/championships/$(request.resource.data.championshipId)).data;
        return champ != null &&
          champ.status == 'inscricoes_abertas' &&
          (champ.registrationsClosed == null || champ.registrationsClosed == false);
      }

      // Helper: valida campos obrigatórios e status inicial permitido
      function hasValidPlayerData() {
        let d = request.resource.data;
        return d.teamId is string && d.teamId.size() > 0 &&
          d.championshipId is string && d.championshipId.size() > 0 &&
          d.name is string && d.name.size() > 0 &&
          // Status só pode ser 'ativo' na criação (fluxo legítimo)
          // 'suspenso', 'lesionado', 'sem_time', 'removido' não são estados iniciais válidos
          (d.status == null || d.status == 'ativo');
      }

      // Criação: atleta via código, capitão ou organizador
      // - Atleta criando próprio registro: valida time aprovado e campeonato aberto
      // - Capitão/organizador: pode criar livremente (já são confiáveis)
      allow create: if isSignedIn() && hasValidPlayerData() && (
        // Atleta criando próprio registro (joinByCode)
        (
          request.resource.data.userId == uid() &&
          isValidTeamForPlayer() &&
          isChampionshipOpen()
        ) ||
        // Capitão adicionando ao próprio time (guestPlayer ou aprovação)
        isTeamCaptain(request.resource.data.teamId) ||
        // Organizador do campeonato
        isChampionshipOrganizer(request.resource.data.championshipId)
      );

      // Helper: verifica se é capitão ou organizador (para updates privilegiados)
      function isPrivilegedForPlayer() {
        return isTeamCaptain(resource.data.teamId) ||
          isChampionshipOrganizer(resource.data.championshipId);
      }

      // Helper: atleta não pode se auto-aprovar (mudar status de inativo para ativo)
      function isNotSelfApproval() {
        let oldStatus = resource.data.status;
        let newStatus = request.resource.data.status;
        // Se status não mudou, ok
        // Se estava ativo e continua ativo, ok
        // Se estava inativo (sem_time, removido) e tenta mudar para ativo, BLOQUEADO
        return newStatus == oldStatus ||
          oldStatus == 'ativo' ||
          oldStatus == 'suspenso' ||
          oldStatus == 'lesionado' ||
          newStatus != 'ativo';
      }

      // Helper: atleta não pode mudar teamId ou championshipId
      function isNotChangingTeamOrChampionship() {
        return request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.championshipId == resource.data.championshipId &&
          request.resource.data.userId == resource.data.userId;
      }

      function selfPlayerUpdateIsSafe() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'photoUrl',
          'position',
          'number',
          'status',
          'leftAt'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
          request.resource.data.status == 'sem_time'
        );
      }

      function captainPlayerUpdateIsSafe() {
        return request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.championshipId == resource.data.championshipId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'photoUrl',
            'position',
            'number',
            'status',
            'leftAt',
            'suspendedRound',
            'yellowCards'
          ]);
      }

      // Update: atleta próprio (restrito), capitão ou organizador (completo)
      allow update: if isSignedIn() && (
        // Atleta atualizando próprio registro: restrições extras
        (
          resource.data.userId == uid() &&
          isNotSelfApproval() &&
          isNotChangingTeamOrChampionship() &&
          selfPlayerUpdateIsSafe()
        ) ||
        (
          isTeamCaptain(resource.data.teamId) &&
          captainPlayerUpdateIsSafe()
        ) ||
        isChampionshipOrganizer(resource.data.championshipId)
      );

      // Delete: apenas capitão ou organizador. Atleta sai do elenco por status='sem_time'.
      allow delete: if isSignedIn() && (
        isTeamCaptain(resource.data.teamId) ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
    }

    // Deterministic team membership index used by Security Rules. Firestore Rules
    // cannot query /players, so team-scoped reads must use this direct lookup.
    match /team_memberships/{membershipId} {
      function membershipIdMatches(data) {
        return membershipId == teamMembershipId(data.teamId, data.userId);
      }

      function hasMatchingPlayer(data) {
        let player = getAfter(/databases/$(database)/documents/players/$(data.playerId)).data;
        return player != null &&
          player.userId == data.userId &&
          player.teamId == data.teamId &&
          player.championshipId == data.championshipId &&
          isActiveMembershipStatus(player.status);
      }

      function membershipCreateIsSafe() {
        return request.resource.data.keys().hasAll([
          'teamId',
          'championshipId',
          'userId',
          'playerId',
          'status'
        ]) &&
        membershipIdMatches(request.resource.data) &&
        (
          (
            request.resource.data.userId == uid() &&
            hasMatchingPlayer(request.resource.data)
          ) ||
          isTeamCaptain(request.resource.data.teamId) ||
          isChampionshipOrganizer(request.resource.data.championshipId)
        );
      }

      function selfMembershipUpdateIsSafe() {
        return resource.data.userId == uid() &&
          request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.championshipId == resource.data.championshipId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.playerId == resource.data.playerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'leftAt',
            'updatedAt'
          ]) &&
          request.resource.data.status == 'sem_time';
      }

      function privilegedMembershipUpdateIsSafe() {
        return membershipIdMatches(request.resource.data) &&
          (
            isTeamCaptain(resource.data.teamId) ||
            isChampionshipOrganizer(resource.data.championshipId)
          );
      }

      allow read: if isSignedIn() && (
        resource.data.userId == uid() ||
        isTeamCaptain(resource.data.teamId) ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
      allow create: if isSignedIn() && membershipCreateIsSafe();
      allow update: if isSignedIn() && (
        selfMembershipUpdateIsSafe() ||
        privilegedMembershipUpdateIsSafe()
      );
      allow delete: if isSignedIn() && (
        isTeamCaptain(resource.data.teamId) ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
    }

    // ── /matches ─────────────────────────────────────────────────────────────

    match /matches/{matchId} {
      allow read: if isSignedIn();
      // Only the championship organizer can create/update/delete matches
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId);
      allow update: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId);
      allow delete: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId);
    }

    // ── /match_events ─────────────────────────────────────────────────────────

    match /match_events/{eventId} {
      function matchIsStillEditable(matchId) {
        // Bloco 5 — Fase A: eventos só podem ser criados/editados/excluídos enquanto a
        // partida está agendada ou ao vivo. Finalizada usa correção controlada;
        // adiada/cancelada/W.O. não aceitam eventos novos.
        return get(/databases/$(database)/documents/matches/$(matchId)).data.status in ['agendado', 'ao_vivo'];
      }

      function finalizedEventCorrectionIsSafe(data) {
        let correctionId = data.lastCorrectionId;
        let correctionPath = /databases/$(database)/documents/match_corrections/$(correctionId);
        return correctionId is string &&
          existsAfter(correctionPath) &&
          getAfter(correctionPath).data.matchId == data.matchId &&
          getAfter(correctionPath).data.championshipId == data.championshipId &&
          getAfter(correctionPath).data.organizerId == uid() &&
          getAfter(correctionPath).data.reason is string &&
          getAfter(correctionPath).data.reason.size() >= 5 &&
          get(/databases/$(database)/documents/matches/$(data.matchId)).data.status == 'finalizado';
      }

      allow read: if isSignedIn();
      // Events are created/edited by the championship organizer (match registration)
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        (
          matchIsStillEditable(request.resource.data.matchId) ||
          finalizedEventCorrectionIsSafe(request.resource.data)
        );
      allow update: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId) &&
        (
          matchIsStillEditable(resource.data.matchId) ||
          finalizedEventCorrectionIsSafe(request.resource.data)
        );
      allow delete: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId) &&
        matchIsStillEditable(resource.data.matchId);
    }

    // ── /match_corrections ───────────────────────────────────────────────────

    match /match_corrections/{correctionId} {
      function correctionHasRequiredFields() {
        let d = request.resource.data;
        return d.championshipId is string &&
          d.matchId is string &&
          d.organizerId == uid() &&
          d.reason is string &&
          d.reason.size() >= 5 &&
          d.previousScore is map &&
          d.newScore is map &&
          d.previousMatchVersion is int &&
          d.newMatchVersion is int &&
          d.newMatchVersion == d.previousMatchVersion + 1 &&
          d.eventsAdded is list &&
          d.eventsRemoved is list &&
          d.eventsChanged is list &&
          d.derivedEffects is list &&
          d.previousMatch is map;
      }

      allow read: if isSignedIn() && isChampionshipOrganizer(resource.data.championshipId);
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        correctionHasRequiredFields() &&
        !exists(/databases/$(database)/documents/match_corrections/$(correctionId));
      allow update, delete: if false;
    }

    // ── /match_status_changes (Bloco 5 — Fase A: auditoria W.O./adiamento/cancelamento) ──

    match /championship_reprocess_logs/{reprocessId} {
      function reprocessLogHasRequiredFields() {
        let d = request.resource.data;
        let correctionPath = /databases/$(database)/documents/match_corrections/$(d.sourceCorrectionId);
        return d.id == reprocessId &&
          d.reprocessId == reprocessId &&
          d.championshipId is string &&
          d.sourceCorrectionId is string &&
          d.sourceMatchId is string &&
          d.reason is string &&
          d.reason.size() >= 5 &&
          d.createdBy == uid() &&
          d.previousResultsDigest is string &&
          d.newResultsDigest is string &&
          d.changed is bool &&
          d.changedFields is list &&
          d.affectedUserIds is list &&
          d.historyDeltas is list &&
          d.achievementGrants is list &&
          d.achievementRevocations is list &&
          d.careerStatsAffected is list &&
          d.rankingsAffected is list &&
          d.idempotencyKey == reprocessId &&
          d.reprocessVersion is int &&
          d.reprocessVersion > 0 &&
          exists(correctionPath) &&
          get(correctionPath).data.championshipId == d.championshipId &&
          get(correctionPath).data.organizerId == uid();
      }

      allow read: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId);
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        reprocessLogHasRequiredFields() &&
        !exists(/databases/$(database)/documents/championship_reprocess_logs/$(reprocessId));
      allow update, delete: if false;
    }

    match /match_status_changes/{changeId} {
      function statusChangeHasRequiredFields() {
        let d = request.resource.data;
        return d.championshipId is string &&
          d.matchId is string &&
          d.organizerId == uid() &&
          d.reason is string &&
          d.reason.size() >= 5 &&
          d.type in ['wo', 'adiamento', 'cancelamento', 'reativacao'] &&
          d.beforeStatus is string &&
          d.afterStatus is string &&
          d.beforeScore is map &&
          d.afterScore is map &&
          d.version is int &&
          d.derivedEffects is list;
      }

      allow read: if isSignedIn() && isChampionshipOrganizer(resource.data.championshipId);
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        statusChangeHasRequiredFields() &&
        !exists(/databases/$(database)/documents/match_status_changes/$(changeId));
      // Logs são imutáveis.
      allow update, delete: if false;
    }

    // ── /join_requests ────────────────────────────────────────────────────────

    // Bloco 10.2: snapshot imutavel dos classificados da fase de grupos.
    match /group_stage_snapshots/{snapshotId} {
      function snapshotHasRequiredFields() {
        let d = request.resource.data;
        return d.id == snapshotId &&
          d.version is int &&
          d.version >= 1 &&
          d.championshipId is string &&
          d.groupGenerationVersion is int &&
          d.groupFixturesVersion is int &&
          d.structureVersion == 1 &&
          d.configVersion == 1 &&
          d.qualifiersPerGroup is int &&
          d.qualifiersPerGroup >= 1 &&
          d.qualifiers is list &&
          d.standingsDigest is string &&
          d.standingsDigest.size() > 0 &&
          d.generatedBy == uid() &&
          d.generatedAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        snapshotHasRequiredFields() &&
        !exists(/databases/$(database)/documents/group_stage_snapshots/$(snapshotId));
      allow update, delete: if false;
    }

    // Bloco 10.2: log imutavel da transicao grupos -> mata-mata.
    match /group_transition_logs/{logId} {
      function transitionLogHasRequiredFields() {
        let d = request.resource.data;
        return d.id == logId &&
          d.championshipId is string &&
          d.transitionVersion is int &&
          d.transitionVersion >= 1 &&
          d.snapshotId is string &&
          d.snapshotDigest is string &&
          d.snapshotDigest.size() > 0 &&
          d.knockoutGenerationVersion is int &&
          d.knockoutGenerationVersion >= 1 &&
          d.qualifierIds is list &&
          d.fixtureIds is list &&
          d.createdBy == uid() &&
          d.createdAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        transitionLogHasRequiredFields() &&
        !exists(/databases/$(database)/documents/group_transition_logs/$(logId));
      allow update, delete: if false;
    }

    // Bloco 10.5: log imutavel do sorteio dos grupos (distribuicao A/B).
    match /group_assignment_logs/{logId} {
      function assignmentLogHasRequiredFields() {
        let d = request.resource.data;
        return d.id == logId &&
          d.championshipId is string &&
          d.generationVersion is int &&
          d.generationVersion >= 1 &&
          d.algorithmVersion == 1 &&
          d.drawSeed is string &&
          d.drawSeed.size() > 0 &&
          d.assignments is list &&
          d.createdBy == uid() &&
          d.createdAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        assignmentLogHasRequiredFields() &&
        !exists(/databases/$(database)/documents/group_assignment_logs/$(logId));
      allow update, delete: if false;
    }

    // Bloco 10.5: log imutavel da geracao das partidas de grupo.
    match /group_fixture_logs/{logId} {
      function fixtureLogHasRequiredFields() {
        let d = request.resource.data;
        return d.id == logId &&
          d.championshipId is string &&
          d.fixturesVersion is int &&
          d.fixturesVersion >= 1 &&
          d.groupGenerationVersion is int &&
          d.groupGenerationVersion >= 1 &&
          d.structureVersion == 1 &&
          d.fixtureIds is list &&
          d.fixtureCount is int &&
          d.groupCounts is map &&
          d.createdBy == uid() &&
          d.createdAt is timestamp;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId) &&
        fixtureLogHasRequiredFields() &&
        !exists(/databases/$(database)/documents/group_fixture_logs/$(logId));
      allow update, delete: if false;
    }

    match /join_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.requesterId == uid() ||
        isTeamCaptain(resource.data.teamId) ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
      // Any signed-in user can create a join request for themselves
      allow create: if isSignedIn() &&
        request.resource.data.requesterId == uid();
      // Only captain or organizer can update (approve/reject)
      allow update: if isSignedIn() && (
        isTeamCaptain(resource.data.teamId) ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
      allow delete: if isSignedIn() && (
        resource.data.requesterId == uid() ||
        isTeamCaptain(resource.data.teamId)
      );
    }

    // ── /team_invites ─────────────────────────────────────────────────────────

    match /team_invites/{inviteId} {
      function captainCreatesOwnInviteAfterTeam() {
        let teamPath = /databases/$(database)/documents/teams/$(request.resource.data.teamId);
        return inviteId == request.resource.data.teamId &&
          existsAfter(teamPath) &&
          getAfter(teamPath).data.captainId == uid() &&
          getAfter(teamPath).data.championshipId == request.resource.data.championshipId;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isTeamCaptain(request.resource.data.teamId) ||
        captainCreatesOwnInviteAfterTeam()
      );
      // Captain manages the invite freely; an athlete may ONLY consume it, i.e.
      // flip it to 'used' attributing it to themselves (no other fields touched).
      allow update: if isSignedIn() && (
        isTeamCaptain(resource.data.teamId) ||
        (
          request.resource.data.status == 'used' &&
          request.resource.data.usedBy == uid() &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status', 'usedBy', 'usedAt'])
        )
      );
      allow delete: if isSignedIn() && isTeamCaptain(resource.data.teamId);
    }

    // ── /round_votes ──────────────────────────────────────────────────────────

    match /round_votes/{voteId} {
      allow read: if isSignedIn();
      // Vote doc ID = championshipId_round_voterId — only the voter creates it.
      // Hardened (AUD-07): enforce ownership, well-formed payload and create-only
      // (no overwrite of an existing vote).
      // ⚠️ PARCIAL: "rodada aberta", "candidato existe" e "candidato de outro time"
      // NÃO são validáveis de forma barata/confiável aqui (exigiriam múltiplos get()
      // cruzados e o ID do voto não carrega o time do votante). Essas regras são
      // revalidadas no votingService.submitVote (contexto confiável). Garantia total
      // contra bypass direto exigiria uma Cloud Function / backend confiável.
      allow create: if isSignedIn() &&
        request.resource.data.voterId == uid() &&
        request.resource.data.championshipId is string &&
        request.resource.data.round is int &&
        request.resource.data.candidatePlayerId is string &&
        request.resource.data.candidatePlayerId.size() > 0 &&
        !exists(/databases/$(database)/documents/round_votes/$(voteId));
      // Votes are immutable
      allow update, delete: if false;
    }

    // ── /round_awards ─────────────────────────────────────────────────────────

    match /round_awards/{awardId} {
      allow read: if isSignedIn();
      // Only the organizer closes voting and creates awards
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId);
      allow update, delete: if false;
    }

    // ── /championship_results ────────────────────────────────────────────────

    match /championship_results/{resultId} {
      allow read: if isSignedIn();
      // Written by the finisher service running as the organizer
      allow write: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId);
    }

    // ── /player_history ──────────────────────────────────────────────────────

    match /player_history/{entryId} {
      allow read: if isSignedIn();
      // Written by the championship finisher/reprocessor in the owning organizer context.
      allow create: if isSignedIn() &&
        isChampionshipOrganizer(request.resource.data.championshipId);
      allow update: if isSignedIn() &&
        isChampionshipOrganizer(resource.data.championshipId) &&
        request.resource.data.championshipId == resource.data.championshipId;
      allow delete: if false;
    }

    // ── /career_stats ─────────────────────────────────────────────────────────

    match /career_stats/{userId} {
      allow read: if isSignedIn();
      // Written by the finisher (organizer) or the user themselves
      allow write: if isSignedIn() && (uid() == userId || isOrganizer());
    }

    // ── /all_time_rankings ────────────────────────────────────────────────────

    match /all_time_rankings/{rankId} {
      allow read: if true;
      // Only an organizer rebuilds rankings via the finisher
      allow write: if isSignedIn() && isOrganizer();
    }

    // ── /notifications ────────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      // A notification may only be created for yourself, or by an organizer
      allow create: if isSignedIn() && (
        request.resource.data.userId == uid() || isOrganizer()
      );
      allow update, delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── /in_app_notifications ─────────────────────────────────────────────────

    match /in_app_notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      // A notification may only be created for yourself, or by an organizer
      allow create: if isSignedIn() && (
        request.resource.data.userId == uid() || isOrganizer()
      );
      allow update, delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── /push_tokens ──────────────────────────────────────────────────────────

    match /push_tokens/{tokenId} {
      // Read your own token, or any token if you are an organizer (to fan out pushes)
      allow read: if isSignedIn() && (resource.data.userId == uid() || isOrganizer());
      allow create, update: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── /announcements ────────────────────────────────────────────────────────

    match /announcements/{announcementId} {
      function canReadAnnouncement(data) {
        return data.targetAudience == 'todos' ||
          isChampionshipOrganizer(data.championshipId) ||
          (data.targetAudience == 'capitaes' && userRole() == 'capitao') ||
          (data.targetAudience == 'atletas' && userRole() == 'atleta') ||
          (
            data.targetAudience == 'time_especifico' &&
            (
              isActiveTeamMember(data.targetTeamId, uid()) ||
              isTeamCaptain(data.targetTeamId)
            )
          );
      }

      function captainAnnouncementCreateIsSafe() {
        return userRole() == 'capitao' &&
          request.resource.data.authorId == uid() &&
          request.resource.data.targetAudience == 'time_especifico' &&
          request.resource.data.targetTeamId is string &&
          isTeamCaptain(request.resource.data.targetTeamId) &&
          get(/databases/$(database)/documents/teams/$(request.resource.data.targetTeamId)).data.championshipId ==
            request.resource.data.championshipId;
      }

      allow read: if isSignedIn() && canReadAnnouncement(resource.data);
      // Organizer of the championship, or a real captain posting as themselves.
      // authorRole is NOT trusted from the payload — the role is read from /users.
      allow create: if isSignedIn() && (
        isChampionshipOrganizer(request.resource.data.championshipId) ||
        captainAnnouncementCreateIsSafe()
      );
      allow update: if isSignedIn() &&
        canReadAnnouncement(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        uid() in request.resource.data.readBy;
      allow delete: if isSignedIn() && (
        resource.data.authorId == uid() ||
        isChampionshipOrganizer(resource.data.championshipId)
      );
    }

    // ── /achievements (legacy flat collection) ────────────────────────────────

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOrganizer();
    }

    // ── /players/{playerId}/achievements (source of truth) ─────────────────────

    match /players/{playerId}/achievements/{achievementId} {
      allow read: if isSignedIn();
      // Granted only by an organizer. Athletes cannot self-award achievements.
      allow write: if isSignedIn() &&
        isChampionshipOrganizer(
          get(/databases/$(database)/documents/players/$(playerId)).data.championshipId
        );
    }

    // ── Convocations (subcollection of teams) ────────────────────────────────
    // LEGADO (Bloco 5 — Fase B): convocação por rodada. Mantida por compatibilidade;
    // a fonte de verdade por PARTIDA passou para /match_convocations.

    match /teams/{teamId}/convocations/{round} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isTeamCaptain(teamId);
    }

    // ── /match_convocations (Bloco 5 — Fase B) ───────────────────────────────
    // ID determinístico: {matchId}_{teamId}. Capitão cria/edita só com a partida
    // ainda aberta; organizador dono administra (inclusive a propagação de status
    // quando a partida já fechou). Versão é estritamente monotônica.

    match /match_convocations/{convId} {
      function convIdMatches(d) {
        return convId == d.matchId + '_' + d.teamId;
      }
      function matchIsOpenForConvocation(matchId) {
        let status = get(/databases/$(database)/documents/matches/$(matchId)).data.status;
        return status == 'agendado' || status == 'adiado';
      }
      function convIdsImmutable() {
        return request.resource.data.matchId == resource.data.matchId &&
          request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.championshipId == resource.data.championshipId;
      }

      allow read: if isSignedIn();

      // Criação: capitão do time (partida aberta) ou organizador dono. Versão = 1.
      allow create: if isSignedIn() &&
        convIdMatches(request.resource.data) &&
        request.resource.data.version == 1 &&
        request.resource.data.status == 'open' &&
        (
          (
            isTeamCaptain(request.resource.data.teamId) &&
            matchIsOpenForConvocation(request.resource.data.matchId)
          ) ||
          isChampionshipOrganizer(request.resource.data.championshipId)
        );

      // Edição: capitão (partida aberta, status open/closed) ou organizador (admin,
      // inclusive cancelado/concluído na propagação). IDs imutáveis, versão += 1.
      allow update: if isSignedIn() &&
        convIdsImmutable() &&
        request.resource.data.version == resource.data.version + 1 &&
        (
          (
            isTeamCaptain(resource.data.teamId) &&
            matchIsOpenForConvocation(resource.data.matchId) &&
            request.resource.data.status in ['open', 'closed']
          ) ||
          isChampionshipOrganizer(resource.data.championshipId)
        );

      // Convocações não são apagadas fisicamente.
      allow delete: if false;
    }

    // ── /match_attendance (Bloco 5 — Fase B) ─────────────────────────────────
    // ID determinístico: {matchId}_{playerId}. O ATLETA responde apenas por si e
    // somente se convocado, com a partida aberta. O organizador NÃO falsifica
    // presença: só pode marcar reconfirmação (sem tocar na resposta).

    match /match_attendance/{attId} {
      function attIdMatches(d) {
        return attId == d.matchId + '_' + d.playerId;
      }
      function matchOpenForAttendance(matchId) {
        let status = get(/databases/$(database)/documents/matches/$(matchId)).data.status;
        return status == 'agendado' || status == 'adiado';
      }
      function convocationAllowsResponse(d) {
        let conv = get(
          /databases/$(database)/documents/match_convocations/$(d.matchId + '_' + d.teamId)
        ).data;
        return conv != null && conv.status == 'open' && (d.playerId in conv.playerIds);
      }
      function isSelfPlayer(d) {
        let player = get(/databases/$(database)/documents/players/$(d.playerId)).data;
        return player != null && player.userId == uid() && player.teamId == d.teamId;
      }
      function attIdsImmutable() {
        return request.resource.data.matchId == resource.data.matchId &&
          request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.playerId == resource.data.playerId &&
          request.resource.data.championshipId == resource.data.championshipId &&
          request.resource.data.userId == resource.data.userId;
      }

      allow read: if isSignedIn();

      // Criação: só o próprio atleta convocado, partida aberta, versão = 1.
      allow create: if isSignedIn() &&
        attIdMatches(request.resource.data) &&
        request.resource.data.version == 1 &&
        request.resource.data.userId == uid() &&
        request.resource.data.response in ['confirmed', 'declined'] &&
        isSelfPlayer(request.resource.data) &&
        matchOpenForAttendance(request.resource.data.matchId) &&
        convocationAllowsResponse(request.resource.data);

      // Edição: (a) o próprio atleta altera a resposta antes do prazo; ou
      //         (b) o organizador APENAS marca reconfirmação (não toca na resposta).
      allow update: if isSignedIn() &&
        attIdsImmutable() &&
        request.resource.data.version == resource.data.version + 1 &&
        (
          (
            request.resource.data.userId == uid() &&
            isSelfPlayer(resource.data) &&
            matchOpenForAttendance(resource.data.matchId) &&
            convocationAllowsResponse(resource.data) &&
            request.resource.data.response in ['confirmed', 'declined']
          ) ||
          (
            isChampionshipOrganizer(resource.data.championshipId) &&
            request.resource.data.response == resource.data.response &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reconfirmationRequired',
              'previousResponse',
              'version',
              'updatedAt'
            ])
          )
        );

      // Respostas não são apagadas fisicamente.
      allow delete: if false;
    }
  }
}
