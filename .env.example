# Required public environment selector.
EXPO_PUBLIC_APP_ENV=development

# Development only. Production and staging must keep this false.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# Optional. Use this for a physical Android device, for example 192.168.1.50.
# Leave blank for web/desktop localhost or Android Emulator 10.0.2.2 auto-resolution.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Non-secret Firebase client project id.
# Use fju-operational-emulator for local emulator, staging project for staging,
# and fju-championship only for production.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=fju-operational-emulator

# Demo/mock mode. Keep false for real Firebase-backed builds.
EXPO_PUBLIC_USE_MOCK=false

# UI-only development switch. This does not grant organizer permission.
# Real organizer onboarding requires organizer_allowlist/{uid} in Firestore.
EXPO_PUBLIC_ALLOW_ORGANIZER_SELF_ASSIGN=false
