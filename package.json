{
  "name": "fju-championship",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "babel-preset-expo": "~56.0.0",
    "expo": "~56.0.9",
    "expo-clipboard": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "^56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.16",
    "expo-keep-awake": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-notifications": "~56.0.16",
    "expo-print": "~56.0.3",
    "expo-sensors": "~56.0.5",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "firebase": "^12.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-chart-kit": "^6.12.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.4",
    "expo-module-scripts": "^56.0.3",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.22.3",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "sharp": "^0.34.5",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "icons": "node scripts/replaceIcons.js",
    "verify": "node scripts/verifyBuild.js",
    "audit:data": "node scripts/auditLegacyData.js",
    "seed:operational": "node scripts/seedOperationalValidation.js",
    "seed:auth-emulator": "node scripts/seedAuthEmulator.js",
    "migrate:data:dry": "node scripts/backfillLegacyData.js --dry-run",
    "migrate:data": "node scripts/backfillLegacyData.js --apply",
    "seed:migrations": "node scripts/seedMigrationEmulatorData.js",
    "validate:migrations:emulator": "firebase emulators:exec --only firestore \"node scripts/validateMigrationEmulator.js\"",
    "test:migrations": "jest --runInBand scripts",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:rules": "firebase emulators:exec --only firestore,storage \"jest --config jest.rules.config.js --runInBand\"",
    "emulators:test": "npm run test:rules",
    "emulators:start": "firebase emulators:start --project fju-operational-emulator --only auth,firestore,storage",
    "emulators:seed": "npm run seed:operational -- --project-id=fju-operational-emulator",
    "emulators:auth-seed": "npm run seed:auth-emulator -- --project-id=fju-operational-emulator",
    "dev:prepare": "firebase emulators:exec --project fju-operational-emulator --only auth,firestore,storage \"npm.cmd run dev:reset\"",
    "dev:reset": "npm.cmd run seed:auth-emulator -- --project-id=fju-operational-emulator --reset && npm.cmd run seed:operational -- --project-id=fju-operational-emulator --reset",
    "dev:android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "e2e": "maestro test .maestro",
    "e2e:home": "maestro test .maestro/home.yaml",
    "e2e:smoke": "maestro test .maestro/smoke.yaml"
  },
  "private": true
}
